# Skopiuj do .env i wklej swój webhook (Ustawienia kanału -> Integracje -> Webhooki)
DISCORD_WEBHOOK_URL=
# Opcjonalnie:
# KEYWORDS=forever            (po przecinku; news musi zawierać któreś słowo)
# INTERVAL_MINUTES=30         (0 = jednorazowo, np. z Harmonogramu zadań)
# FEED_URL=https://www.wowhead.com/news/rss/classic
